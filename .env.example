# SprintZero configuration. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides -----------------------------------------------------
# Both agents default to claude-opus-4-7. Do not raise these without re-running
# _probe_agent1_models.py: a newer model measured 2.4-3.2x SLOWER here, because
# thinking is on by default there and was off before. See docs/DECISIONS.md.
# SPRINTZERO_AGENT1_MODEL=claude-opus-4-7
# SPRINTZERO_AGENT2_MODEL=claude-opus-4-7

# Fast mode. Off by default: it returned 429 on every attempt during testing,
# since it carries a rate limit separate from standard Opus.
# SPRINTZERO_FAST_MODE=0

# Write one JSON line per model call to state/latency_trace.jsonl. On by default.
# SPRINTZERO_TRACE=1

# Packaged app only: dump all thread stacks to the startup log after N seconds.
# SPRINTZERO_DEBUG_STACKS=8
